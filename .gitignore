.vscode

# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Ignore all original Firebase JS SDK packages
/docs-devsite/*
!/docs-devsite/README.md
/packages/*
!/packages/README.md

# scripts and tools
publish.bat



# Live-test credentials (see tests/live_endpoints.rs). Never commit these.
google-services.json
GoogleService-Info.plist
.env
.env.*
.firebase/

# Firebase Local Emulator Suite
firebase-emulator/functions/node_modules/
*-debug.log
.firebase/
