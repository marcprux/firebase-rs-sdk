rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Scratch folder used by tests/live_endpoints.rs; the tests sign in anonymously.
    match /rust_sdk_live_tests/{fileName=**} {
      allow read, write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
