rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Scratch collection used by tests/live_endpoints.rs. Any signed-in user (the tests sign in
    // anonymously) may read and write here. Mirrors the rules published on the real project.
    match /rust_sdk_live_tests/{docId} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
